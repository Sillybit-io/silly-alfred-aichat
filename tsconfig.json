{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["bun"],
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": false,
    "resolveJsonModule": true
  },
  "include": ["src", "scripts", "tests"]
}
